# Supabase Configuration
# These are required for image upload and generation features.
# Leave blank for local preview mode only.

# Supabase project URL (from Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous API key (from Supabase dashboard)
SUPABASE_ANON_KEY=your-anon-key-here

# Node environment (development, production, test)
NODE_ENV=development

# Optional: External provider API keys
# SEEDREAM_API_KEY=your-key-here
# RUNPOD_API_KEY=your-key-here
