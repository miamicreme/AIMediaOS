# Copy this file to apps/web/.env.local and fill in as real provider
# integrations are added. The web app calls these providers directly
# through its own /api/jobs route — there is no separate API service to run.
# Without these set, /api/jobs still runs but returns a clear "not configured"
# error instead of a generated result.

# Seedream-compatible image provider.
# The adapter supports fal-style endpoints first because AiPose exposes Seedream 4.x labels publicly.
# Use the actual endpoint slug from your provider account.
SEEDREAM_API_KEY=
SEEDREAM_ENDPOINT=
SEEDREAM_BASE_URL=https://fal.run

# Alternative key name accepted by the Seedream adapter.
FAL_KEY=

# RunPod async provider for custom image/video workers.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_BASE_URL=https://api.runpod.ai/v2

# Supabase configuration for authentication and database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Stripe payment processing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=price_xxx  # Create in Stripe dashboard
STRIPE_PRICE_PRO_ANNUAL=price_xxx   # Create in Stripe dashboard

# Application URL for redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
